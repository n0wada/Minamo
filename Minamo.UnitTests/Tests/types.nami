#region "Initialization blocks 1"
    struct Nat { x }
    impl Nat {
        let num

        func init(x) {
            if x == 0 {
                throw Exception<InvalidValue>(x)
            }
            this.num = math.abs(x)
        }
    }
    func Nat as Integer => this.num
    mut x = Nat(12)
    assert(12, x as Integer)
    x = Nat(-24)
    assert(24, x as Integer)
    try {
        x = Nat(0)
        assert(got: false)
    } catch e {
        if constructorName(e) == "InvalidValue" {
            let x = e[0]
            assert(0, x)
        }
    }
#endregion

#region "Initialization blocks 2"
    enum Expr {
        Literal(typ) {
            if typ is not "num" and not "string" {
                typ = "nil"
            }
        }
        ,
        Function(args: Integer) {
            if args < 0 {
                args = 0
            }
        }
    }
    assert("num", Expr.Literal("num").typ)
    assert("nil", Expr.Literal("char").typ)
    assert(3, Expr.Function(3).args)
    assert(0, Expr.Function(-5).args)
#endregion

#region "Custom fields and pattern matching"
    struct Foo {  }
    func get Foo[key] {
	    match key {
		    "id" => 42,
		    "code" => "Code:Foo"
	    }
    }
    func Foo.In(field) => field is "id" or "code"
    let f = Foo()
    assert(42, f.id)
    assert("Code:Foo", f.code)
    assert(true, "id" in f)

    match f {
	    value when value.id == 42 && value.code == "Code:Foo" => {
            assert(42, value.id)
            assert("Code:Foo", value.code)
        },
        _ => assert(got: false)
    }
#endregion

#region "Default conversions"
    struct Foo { x, y, z }
    let f = Foo(1, 2, 3)
    assert([1,2,3], f as Array)
    assert((x: 1, y: 2, z: 3), f as Tuple)
    assert("[\"x\": 1, \"y\": 2, \"z\": 3]", (f as Dictionary).ToString())
#endregion

#region "Method overwrite 2"
    struct Foo {  }
    static func Foo.Bar() { 1 }
    static func Foo.Bar() { 2 }
    assert(2, Foo.Bar())
#endregion

#region "Delete member"
    struct TemporaryMember { }
    func TemporaryMember.InstanceValue() => 1
    static func TemporaryMember.StaticValue() => 2
    let value = TemporaryMember()
    assert(true, TemporaryMember.Has("StaticValue"))
    assert(true, value.Has("InstanceValue"))
    TemporaryMember.DeleteMember("StaticValue")
    TemporaryMember.DeleteMember("InstanceValue")
    assert(false, TemporaryMember.Has("StaticValue"))
    assert(false, value.Has("InstanceValue"))
#endregion

#region "Lower-case methods and properties"
    struct Counter { value }
    impl Counter {
        mut current

        func init(value) {
            this.current = value
        }
    }
    func Counter.increment(step) {
        this.current = this.current + step
        this.current
    }
    func Counter.value() {
        this.current
    }
    func get Counter.total() {
        this.current
    }
    func set Counter.total(next) {
        this.current = next
    }
    let counter = Counter(10)
    assert(15, counter.increment(5))
    assert(15, counter.value())
    assert(15, counter.total)
    counter.total = 99
    assert(99, counter.value())
#endregion
