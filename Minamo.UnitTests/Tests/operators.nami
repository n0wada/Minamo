#region "Simple math"
    mut x = 12 + 3 - 4 + 6
    assert(17, x)
    x = 12 + 3 - (4 + 6)
    assert(5, x)
    x = 12 * 3 - 4 + 6
    assert(38, x)
    x = 12 * (3 - 4 + 6)
    assert(60, x)
    x = 64 / 5
    assert(12, x)
#endregion

#region "Float math 1"
    mut x = 12.4 - 0.39 - 12.0
    assert(0.0099999999999997868, x)
    x = 12.4 - (0.39 - 12.0)
    assert(24.009999999999998, x)
    x = 12.0 - 65.3
    assert(-53.3, x)
#endregion

#region "Float math 2"
    mut x = 22 % 4 - 3.33 / 8.16
    assert(1.5919117647058822, x)
    x = 12.3 / (0.64 + 1.22)
    assert(6.6129032258064528, x)
    x = 12.3 / 0.64 + 1.22
    assert(20.43875, x)
    x = 23.456 % 12.2
    assert(11.256, x)
    x = 12.0 * 65.3
    assert(783.59999999999991, x)
    x = 188.123 - 12.0004 * 5.667 - (12.2 / 0.134)
    assert(29.071957080597016, x)
    x = (188.123 - 12.0004) * 5.667 - 12.2 / 0.134
    assert(907.04199808059684, x)
#endregion

#region "Math with formatting"
    mut x = 2
        + 3
        + 5
        + 6
    assert(16, x)
    mut y = 12
        + 
        -44
    assert(-32, y)
    mut z = 12
        + -3
        --12
        -44
    assert(-23, z)
#endregion

#region "Math with unary"
    mut x = -12 - 14.6
    assert(-26.6, x)
    x = 199 % 44.12 * 2
    assert(45.04000000000002, x)
    x = +16 - -22
    assert(38, x)
#endregion

#region "Inf"
    mut x = 2.0 / 0
    assert(true, x == Float.Infinity)
#endregion

#region "NaN"
    mut x = .0 / 0
    assert(true, x.IsNaN())
#endregion

#region "Logical Or"
    let x = 144
    mut res = x / 12 > 100 || x / 6 == 24
    assert(true, res)
#endregion

#region "Logical And"
    let x = 144
    mut res = x / 12 > 100 && x / 6 != 24
    assert(false, res)
#endregion

#region "Comparison"
    let res = 12 > 11 && 12 <= 12 && 12 != 12.01 && 12 >= 12
    assert(true, res)
    assert(true, "string1" != "string2" && "string1" == "string1")
    let x = 12
    let y = 9
    assert(false, !(x >= 12 && y <= 10 || x < -12))
#endregion

#region "Comparison and coersion"
    assert(true, 12.0 == 12)
    assert(true, 12 == 12.0)
    assert(true, 12.2 > 12)
    assert(true, 12 < 12.2)
#endregion

#region "Comparison and bool"
    let str1 = "x"
    let str2 = ""
    assert(false, str1 == true)
    assert(false, str2 == true)
    assert(false, str2 == false)
    assert(got: true == true)
    assert(got: false == false)
    assert(false, true == false)
#endregion

#region "Function comparison 1"
    assert(true, "".ToString == "".ToString)
    assert(false, "".ToString == '\0'.ToString)
    assert(true, 12.ToString == 12.ToString)
    assert(false, 12.ToString == 24.ToString)
#endregion

#region "Function comparison 2"
    let xs = [1,2,3]
    let ys = [4,5,6]
    assert(true, xs.LastIndexOf == xs.LastIndexOf)
    assert(false, xs.LastIndexOf == ys.LastIndexOf)
#endregion

#region "Function comparison 3"
    struct Foo {  }
    func Foo.DoSomething(x, y) => (x,y)
    let f1 = Foo()
    let f2 = Foo()
    assert(true, f1.DoSomething == f1.DoSomething)
    assert(false, f1.DoSomething == f2.DoSomething)
#endregion

#region "Function comparison 4"
    let xs = (1,2,3)
    let ys = (4,5,6)
    assert(true, xs.First == xs.First)
    assert(false, xs.First == ys.First)
    let zs = (1,2,3)
    assert(true, xs.First == zs.First)
#endregion

#region "Coalesce"
    let z = nil
    let foo = "foo"
    let obj = false
    assert("foo", z ?? foo)
    assert("foo", obj ?? z ?? foo)
    mut fallbackCalls = 0
    assert(42, Some(42) ?? {
        fallbackCalls += 1
        0
    })
    assert(0, fallbackCalls)
    assert(133, None ?? {
        fallbackCalls += 1
        133
    })
    assert(1, fallbackCalls)
    mut x = 2
    mut y
    x ??= 3
    y ??= 133
    assert((2, 133),(x,y))
#endregion

#region "Member check 1"
    assert(true, "string".Has("Length"))
    assert(false, 42.Has("FooBar"))
    assert(true, String.Has("Join"))
    assert(false, String.Has("Foo"))
    assert(true, "".Has("Split"))
    assert(false, "".Has("Join"))
#endregion

#region "nameof"
    func nameofTest() { }
    assert("nameofTest", nameof(nameofTest))
    assert("toString", nameof("".toString))
    mut tup = (x: 12)
    assert("x", nameof(tup.x))
    assert("Integer", nameof(Integer))
#endregion

#region "Has 1"
    let nm = "Split"
    assert(true, "".Has(nm))
    assert(true, "".Has("Split"))
    assert(true, "".Has("Split"))
    assert(true, String.Has("Join"))
    assert(false, String.Has("Split"))
#endregion

#region "Has 2"
    mut t = (1,2,3)
    assert(false, t.Has("Foo"))
    mut foo = "Foo"
    assert(false, t.Has(foo))
    assert(true, t.Has("Keys"))
    mut keys = "Keys"
    assert(true, t.Has(keys))
#endregion

#region "Has 3"
    mut t = [1,2,3]
    assert(false, t.Has("Foo"))
    mut foo = "Foo"
    assert(false, t.Has(foo))
    assert(true, t.Has("Indices"))
    mut indices = "Indices"
    assert(true, t.Has(indices))
#endregion

#region "Ternary"
    mut x = 0
    mut res = x > 0 ? x
        : x < 0 ? -x : 42
    assert(42, res)
    func fib(n) =>
        n < 2 ? n : fib(n - 1) + fib(n - 2)
    assert(89, fib(11))
#endregion

#region "Unary minus"
    let x = - 42 //with space
    assert(0 - 42, x)
#endregion

#region "In"
    mut xs = (x: 12, y: 24)
    assert(true, "x" in xs)
    assert(true, "y" in xs)
    assert(false, "z" in xs)
    xs = Dictionary.FromTuple(xs)
    assert(true, "x" in xs)
    assert(true, "y" in xs)
    assert(false, "z" in xs)
#endregion

#region "As"
    struct Foo { x }
    func Integer as Char { this.ToString()[0] }
    func Integer as Foo { Foo(this) }
    let x = 42
    assert('4', 42 as Char)
    if x as Foo is Foo(y) {
        assert(42, y)
    } else {
        assert(got: false)
    }
#endregion

#region "Operation 'in' with exception"
    try {
        1 in 12
        assert(got: false)
    } catch e {
        if constructorName(e) == "OperationNotSupported" {
            assert(got: true)
        }
    }
    try {
        1.Contains
        assert(got: false)
    } catch e {
        if constructorName(e) == "OperationNotSupported" {
            assert(got: true)
        }
    }
#endregion

#region "Unary plus"
    func Integer +() {
        this + this
    }
    let x = +3
    assert(6, x)
#endregion

#region "Overloadable shift operators"
    struct Shiftable { value }
    func Shiftable +(other) => Shiftable(this.value + "+" + other.value)
    func Shiftable <<(other) => Shiftable("(" + this.value + "<<" + other.value + ")")
    func Shiftable >>(other) => Shiftable("(" + this.value + ">>" + other.value + ")")

    let left = Shiftable("a")
    let middle = Shiftable("b")
    let right = Shiftable("c")
    assert("(a<<b+c)", (left << middle + right).value)
    assert("(a>>b+c)", (left >> middle + right).value)
    assert("((a<<b)<<c)", ((left << middle) << right).value)

    let unsupported = try {
        1 << 2
        false
    } catch e {
        constructorName(e) == "OperationNotSupported"
    }
    assert(true, unsupported)
#endregion
