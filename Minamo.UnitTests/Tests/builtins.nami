#region "Initialize"
import math as math
#endregion
#region "const declarations"
    const { ONE, TWO = "2", THREE = 3 }
    assert("ONE", ONE)
    assert("2", TWO)
    assert(3, THREE)

    const FOUR = 4
    assert(4, FOUR)
#endregion
#region "round" 
    mut x = math.round(42.12345) //Evaluates to 42.12
    mut y = math.round(42.12345, 4) //Evaluates to 42.1234
    assert(42.12, x)
    assert(42.1234, y)
#endregion

#region "min" 
    mut x = math.min(12, 2)
    assert(2, x)
    x = math.min(2, 24)
    assert(2, x)
    x = math.min(12, 12)
    assert(12, x)
    x = math.min(-12, 0)
    assert(-12, x)
#endregion

#region "max" 
    mut x = math.max(12, 2)
    assert(12, x)
    x = math.max(2, 24)
    assert(24, x)
    x = math.max(12, 12)
    assert(12, x)
    x = math.max(-12, 0)
    assert(0, x)
#endregion

#region "sign" 
    mut x = math.sign(123)
    assert(1, x)
    x = math.sign(-668)
    assert(-1, x)
    x = math.sign(0)
    assert(0, x)
#endregion

#region "sqrt" 
    mut x = math.sqrt(246)
    x = math.round(x, 4)
    assert(15.6844, x)
#endregion

#region "abs" 
    assert(12, math.abs(-12))
    assert(42, math.abs(42))
    let x = -14.102
    assert(14.102, math.abs(x))
#endregion

#region "pow"
    assert(46918, Integer(math.pow(12.2, 4.3)))
    assert(3111696, Integer(math.pow(42, 4)))
#endregion

#region "assert"
    try {
        assert(expect: 1, got: 2, errorText: "Strange!!!")
    } catch e {
        if constructorName(e) == "AssertionFailed" {
            let str = e[0]
            assert("Strange!!!", str)
        }
    }
#endregion

#region "Indexer internal storage access"
    struct Foo { mut x, mut y, mut z }
    func get Foo[index] {
        match index {
            i when i > 2 || i < 0 => Exception<IndexOutOfRange>(index),
            _ => this[index]
        }
    }
    func set Foo[index, value] {
        match index {
            i when i > 2 || i < 0 => Exception<IndexOutOfRange>(index),
            _ => this[index] = value
        }
    }
    let f = Foo(1, 2, 3)
    assert(2, f[1])
    f[1] = 1024
    assert(1024, f[1])
#endregion

#region "Tuple indexed assignment and read-only fields"
    let xs = (1, 2, 3)
    try {
        xs[0] = 12
        assert(got: false)
    } catch e {
        if constructorName(e) == "IndexReadOnly" {
            assert(got: true)
        }
    }
#endregion

#region "constructorName"
    enum Foo { Foo, Bar }
    enum FooBar { FooBar }
    assert("Foo", constructorName(Foo.Foo))
    assert("Bar", constructorName(Foo.Bar))
    assert("FooBar", constructorName(FooBar.FooBar))
    assert(nil, constructorName(12))
#endregion

#region "typeName"
    struct Bar {  }
    assert("Bar", typeName(Bar()))
    assert("Bar", typeName(Bar().GetType()))
    let ex = Exception<Foo>()
    assert("Exception", typeName(ex))
    assert("Exception", typeName(ex.GetType()))
    assert("Char", typeName('c'.GetType()))
    assert("Char", typeName('c'))
#endregion

#region "referenceEquals 1"
    mut x = 2
    mut y = 1 + 1
    assert(true, x == y)
    assert(false, referenceEquals(x, y))
#endregion

#region "referenceEquals 2"
    let xs = (1,2,3)
    let ys = (1,2,3)
    assert(true, xs == ys)
    assert(false, referenceEquals(xs, ys))
#endregion

#region "isCallable"
    func echo(value) => value
    assert(true, isCallable(echo))
    assert(true, isCallable(value => value))
    assert(false, isCallable(42))
#endregion
