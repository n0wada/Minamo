#region "Json: parse and stringify"
    let value = Json.Parse("""{"name":"Ada","active":true,"scores":[1,2.5,null]}""")
    assert("Ada", value["name"])
    assert(true, value["active"])
    assert(2.5, value["scores"][1])
    assert(nil, value["scores"][2])
    assert("{\"name\":\"Ada\",\"active\":true,\"scores\":[1,2.5,null]}", Json.Stringify(value))
#endregion

#region "Result: GetType"
    assert(Result, Ok(true).GetType())
    assert("Result", typeName(Ok(true).GetType()))
#endregion

#region "Result: Length and indexer"
    let x = Ok(42)
    assert(1, x.Length())
    assert(42, x.x)
    assert(42, x[0])
#endregion

#region "Result: matching 1"
    let x = Ok(42)
    if x is Ok(value) {
        assert(42, value)
    } else {
        assert(got: false)
    }
#endregion

#region "Result: matching 2"
    let x = Ok(42)
    if x is (42,) {
        assert(got: true)
    } else {
        assert(got: false)
    }
    assert(got: x is (xx,))
    assert(42, xx)
    let y = Err("fail")
    if y is Err(str) {
        assert("fail", str)
    } else {
        assert(got: false)
    }
#endregion

#region "ByteArray: GetType"
    let barr = ByteArray()
    assert(ByteArray, barr.GetType())
    assert("ByteArray", typeName(barr.GetType()))
#endregion

#region "ByteArray: encodings and raw conversion"
    let utf8 = ByteArray.FromString("Minamo ✓")
    assert("Minamo ✓", utf8.Decode())
    assert("4D696E616D6F20E29C93", utf8.ToHex())
    assert(utf8.ToHex(), ByteArray.FromHex(utf8.ToHex()).ToHex())
    assert(utf8.ToHex(), ByteArray.FromBase64(utf8.ToBase64()).ToHex())
    assert([0, 1, 127, 255], ByteArray.FromArray([0, 1, 127, 255]).ToArray())
#endregion
