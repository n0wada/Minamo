import station

let reactor = station.Reactor()
let sameReactor = station.Reactor()
assert(reactor.Id, sameReactor.Id)

let zone = "engineering"
host.Log.Warning("Emergency reported in " + zone)

let door = station.Door(zone)
door.Lock()
reactor.SetOutput(85.0)

station.Broadcast(
    "Locked " + zone + " and raised reactor output to 85%.")
