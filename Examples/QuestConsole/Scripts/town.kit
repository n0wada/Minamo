func questGame() {
    mut courierQuestKnown = false
    mut courierQuestAccepted = false

    select {
        initial state "square" {
            choose "guard"
                label "Talk to the guard"
                description "Ask about work near the old bridge" => goto "guard"

            choose "board"
                label "Check the quest board"
                description "Review the work currently available" => {
                if courierQuestAccepted {
                    print("\nQuest board: You have one active quest.")
                } else {
                    print("\nQuest board: Ask the guard about work in the town square.")
                }
            }

            choose "active-quest"
                label "Review your active quest"
                description "Confirm the courier assignment"
                when courierQuestAccepted => {
                print("\nActive quest: Find the missing courier.")
            }

            choose "leave" label "Leave the town square" => exit
        }

        state "guard" {
            choose "ask"
                label "Ask about the missing courier"
                description "Learn why the guard needs help"
                when !courierQuestKnown => {
                courierQuestKnown = true
                print("\nGuard: A courier vanished near the old bridge.")
            }

            choose "accept"
                label "Accept the courier quest"
                description "Add the search to your active quests"
                when courierQuestKnown && !courierQuestAccepted => {
                courierQuestAccepted = true
                print("\nQuest accepted: Find the missing courier.")
                goto "square"
            }

            choose "back"
                label "Return to the town square" => goto "square"
        }
    }
}

alias(questGame(), "quest.town")
