func questGame() {
    select {
        mut courierQuestKnown = false
        mut courierQuestAccepted = false
        mut screen = "square"

        action "guard" when screen == "square" [
            "text": "Talk to the guard"
        ] => {
            screen = "guard"
        }

        action "board" when screen == "square" [
            "text": "Check the quest board"
        ] => {
            if courierQuestAccepted {
                print("\nQuest board: You have one active quest.")
            } else {
                print("\nQuest board: Ask the guard about work in the town square.")
            }
        }

        action "active-quest" when screen == "square" && courierQuestAccepted [
            "text": "Review your active quest"
        ] => {
            print("\nActive quest: Find the missing courier.")
        }

        action "leave" when screen == "square" [
            "text": "Leave the town square"
        ] => exit

        action "ask" when screen == "guard" && !courierQuestKnown [
            "text": "Ask about the missing courier"
        ] => {
            courierQuestKnown = true
            print("\nGuard: A courier vanished near the old bridge.")
        }

        action "accept" when screen == "guard" && courierQuestKnown && !courierQuestAccepted [
            "text": "Accept the courier quest"
        ] => {
            courierQuestAccepted = true
            screen = "square"
            print("\nQuest accepted: Find the missing courier.")
        }

        action "back" when screen == "guard" [
            "text": "Return to the town square"
        ] => {
            screen = "square"
        }
    }
}

alias(questGame(), "quest.town")
