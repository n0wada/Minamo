<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SpellkitRuntimeTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Spellkit.Examples.OrderWorkflow</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Spellkit.Generators\Spellkit.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Spellkit\Spellkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\**\*.kit" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
