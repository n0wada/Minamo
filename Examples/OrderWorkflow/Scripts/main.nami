import workflow/model as model
import workflow/validation as validation
import workflow/shipping as shipping
import workflow/notifications as notifications
import orders

func onSubmitted(payload) {
    let order = model.FromPayload(payload)
    orders.Record("submitted")

    if validation.Accept(order) {
        orders.RequestPayment(order.id)
        host.Log.Info(notifications.Submitted(order))
    } else {
        host.Log.Warning(notifications.Rejected(order, validation.Reason(order)))
    }
}

func onPaymentConfirmed(payload) {
    let order = model.FromPayload(payload)
    let plan = shipping.For(order)

    orders.Record("paid")
    host.Log.Info(notifications.Paid(order, plan))
    onShipmentRequested((order, plan))
}

func onShipmentRequested(event) {
    let order = event[0]
    let plan = event[1]

    orders.Record("shipped")
    orders.CreateShipment(order.id, plan.carrier, plan.priority)
    host.Log.Info(notifications.Shipped(order, plan))
}

for payload in submittedOrders {
    onSubmitted(payload)
}

for payload in confirmedPayments {
    onPaymentConfirmed(payload)
}

print(fmt(
    "Order workflow completed: submitted={0}, paid={1}, shipped={2}.",
    host.Registry["submitted"],
    host.Registry["paid"],
    host.Registry["shipped"]))
