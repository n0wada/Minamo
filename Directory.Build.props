<Project>
  <PropertyGroup>
    <!-- Product identity lives here so a future rename does not require editing every project. -->
    <MinamoProductName>Minamo</MinamoProductName>
    <MinamoVersion>0.9.4</MinamoVersion>
    <MinamoCompany>Minamo Contributors</MinamoCompany>
    <MinamoCopyright>Copyright (c) Minamo Contributors</MinamoCopyright>
    <MicrosoftCodeAnalysisVersion>4.1.0</MicrosoftCodeAnalysisVersion>
    <MicrosoftCodeAnalysisAnalyzersVersion>3.3.3</MicrosoftCodeAnalysisAnalyzersVersion>
    <MicrosoftNetTestSdkVersion>18.7.0</MicrosoftNetTestSdkVersion>
    <CoverletCollectorVersion>10.0.1</CoverletCollectorVersion>
    <XunitVersion>3.2.2</XunitVersion>
    <XunitRunnerVisualStudioVersion>3.1.5</XunitRunnerVisualStudioVersion>
    <MinamoRuntimeTargetFramework>net10.0</MinamoRuntimeTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MinamoOutputRoot>$(MSBuildThisFileDirectory)bin\</MinamoOutputRoot>
    <MinamoGeneratorOutputPath Condition="'$(Configuration)' == 'Release'">$(MinamoOutputRoot)Minamo.Generators.dll</MinamoGeneratorOutputPath>
    <MinamoGeneratorOutputPath Condition="'$(Configuration)' != 'Release'">$(MinamoOutputRoot)tools\generators\$(Configuration)\Minamo.Generators.dll</MinamoGeneratorOutputPath>
    <MinamoProductProject Condition="'$(MSBuildProjectName)' == 'Minamo'
      Or '$(MSBuildProjectName)' == 'Minamo.Console'">true</MinamoProductProject>
    <OutputPath>$(MinamoOutputRoot)projects\$(MSBuildProjectName)\$(Configuration)\</OutputPath>

    <Version Condition="'$(Version)' == ''">$(MinamoVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(MinamoVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(MinamoVersion)</FileVersion>
    <Company Condition="'$(Company)' == ''">$(MinamoCompany)</Company>
    <Product Condition="'$(Product)' == ''">$(MinamoProductName)</Product>
    <Copyright Condition="'$(Copyright)' == ''">$(MinamoCopyright)</Copyright>
    <Trademark Condition="'$(Trademark)' == ''">$(MinamoCompany)</Trademark>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''" />
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''" />
    <RepositoryType Condition="'$(RepositoryType)' == ''" />
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <WarningLevel Condition="'$(WarningLevel)' == ''">9999</WarningLevel>
    <Configurations>Debug;Release;DebugGenerators</Configurations>

    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).nuget\packages</RestorePackagesPath>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!-- Keep distributable Release files at bin root and isolate development-only outputs. -->
  <PropertyGroup Condition="'$(MinamoProductProject)' == 'true' And '$(Configuration)' == 'Release'">
    <OutputPath>$(MinamoOutputRoot)</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MinamoProductProject)' == 'true' And '$(Configuration)' == 'Debug'">
    <OutputPath>$(MinamoOutputRoot)debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MinamoProductProject)' == 'true' And '$(Configuration)' == 'DebugGenerators'">
    <OutputPath>$(MinamoOutputRoot)debug-generators\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Minamo.UnitTests'
    And '$(LanguageRunner)' != 'true'">
    <OutputPath>$(MinamoOutputRoot)tests\unit\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Minamo.UnitTests'
    And '$(LanguageRunner)' == 'true'">
    <BaseIntermediateOutputPath>obj\language-runner\</BaseIntermediateOutputPath>
    <OutputPath>$(MinamoOutputRoot)tests\language\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Minamo.Generators' And '$(Configuration)' == 'Release'">
    <OutputPath>$(MinamoOutputRoot)</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Minamo.Generators' And '$(Configuration)' != 'Release'">
    <OutputPath>$(MinamoOutputRoot)tools\generators\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StationConsole'">
    <OutputPath>$(MinamoOutputRoot)examples\StationConsole\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'DebugGenerators'">
    <NoWarn Condition="'$(NoWarn)' == ''">1701;1702;CA1822</NoWarn>
  </PropertyGroup>
</Project>
