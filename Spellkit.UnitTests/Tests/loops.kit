#region "For as expression, break with value"
    func void(x) => x
    let x =
        for x in Iterator.Range(0, 100, 2) {
            void(x)
            if x > 10 {
                break x
            }
            void(x)
        }
    assert(12, x)
    let y =
        for x in 0..100 {
            if x > 10 {
                break x
            }
        }
    assert(11, y)
#endregion

#region "For as expression, break"
    let x =
        for x in 0..10 {
            break
        }
    assert(nil, x)
    let y =
        for x in 0..10 {
            x
        }
    assert(nil, y)
#endregion

#region "For as function body"
    func run(to) {
        for x in 0..to {
            if x > 0 {
                break x
            }
        }
    }
    assert(1, run(10))
#endregion

#region "For as function body 2"
    func run(to) {
        mut ret
        for x in Iterator.Range(0, to, 2) {
            if x > 0 {
                ret = x
                break
            }
        }
        return ret
    }
    assert(2, run(10))
#endregion

#region "For: down to 1"
    mut last
    for x in Iterator.Range(20, 0, -2, exclusive: true) {
        last = x
    }
    assert(2, last)
#endregion

#region "For: down to 2"
    mut last = 0
    for _ in Iterator.Range(20, 0, -7) {
        last += 1
    }
    assert(3, last)
#endregion

#region "For: up to"
    mut last = 0
    for _ in Iterator.Range(20, 0, 7) {
        last += 1
    }
    mut last2 = 0
    for _ in Iterator.Range(20, 0, 7) {
        last2 += 1
    }
    assert(last, last2)
#endregion
